{
  "name": "alip-workspace",
  "version": "0.6.0",
  "private": true,
  "description": "TN-Workspace - superapp desktop berpusat task, dibuat oleh TransformNusa",
  "main": "./out/main/index.js",
  "author": "Alip T. S. (TransformNusa)",
  "scripts": {
    "dev": "cross-env NO_SANDBOX=1 electron-vite dev",
    "dev:raw": "electron . --no-sandbox",
    "dev:nosandbox": "cross-env NO_SANDBOX=1 electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "measure": "cross-env ALIP_MEASURE=1 electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win",
    "setup": "npm install --ignore-scripts && node node_modules/electron/install.js",
    "setup:python": "node scripts/setup-python.mjs",
    "measure:web": "cross-env ALIP_MEASURE=web electron-vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
